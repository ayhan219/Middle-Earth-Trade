<script>
    let materials = [];
    let playerGold = 2450;
    let playerInventory = {};
    
    function getMaterialIcon(name){
        const n = (name || '').toLowerCase();
        // Genel türler önce
        if (n.includes('harita') || n.includes('map')) return '🗺️';
        if (n.includes('kitap') || n.includes('book') || n.includes('mazarbul') || n.includes('yazıt') || n.includes('yazit') || n.includes('iskenderun')) return '📜';
        if (n.includes('zırh') || n.includes('zirh') || n.includes('armor') || n.includes('gömlek') || n.includes('gomlek') || n.includes('chain')) return '🛡️';
        if (n.includes('sword') || n.includes('kılıç') || n.includes('kilic') || n.includes('glamdring') || n.includes('narsil') || n.includes('andúril') || n.includes('anduril') || n.includes('sting') || n.includes('stıng') || n.includes('orcrist') || n.includes('orcrıst')) return '🗡️';
        if (n.includes('elf') && (n.includes('pelerini') || n.includes('cloak'))) return '🧝';
        if (n.includes('elf') && (n.includes('yay') || n.includes('bow'))) return '🏹';
        if (n.includes('vilya')) return '💠';
        if (n.includes('narya')) return '🔥';
        if (n.includes('silmaril')) return '💎';
        if (n.includes('mithril')) return '⚔️';
        if (n.includes('palant')) return '🔮';
        if ((n.includes('dokuz') && n.includes('yüzük')) || (n.includes('tek') && n.includes('yüzük')) || (n.includes('yedi') && n.includes('yüzük')) || n.includes('ring')) return '💍';
        if (n.includes('gümüş') || n.includes('silver')) return '🥈';
        if (n.includes('altın') || n.includes('altin') || n.includes('gold')) return '🪙';
        if (n.includes('lembas')) return '🥖';
        if (n.includes('dark') && n.includes('flame')) return '🔥';
        if (n.includes('dragon')) return '🐉';
        if (n.includes('nenya')) return '💠';
        if (n.includes('arkenstone')) return '💎';
        if (n.includes('miruvor') || n.includes('mıruvor')) return '🍷';
        if (n.includes('healing') || n.includes('herb') || n.includes('ent-dalma') || n.includes('ent')) return '🌿';
        return '📦';
    }
    
    let tradeAction = null;
    let tradeMaterialIndex = null;

    async function fetchMaterials() {
        try {
            const response = await api.get('/api/material'); 
            materials = response.data;
            renderMaterials();
        } catch (error) {
            console.error("Could not fetch materials:", error);
            showNotification("Could not fetch data from server.", 'error');
        }
    }

    function openTradeModal(action, index) {
        tradeAction = action;
        tradeMaterialIndex = index;
        const material = materials[index];
        const title = action === 'buy' ? 'Buy' : 'Sell';
        document.getElementById('tradeModalTitle').textContent = title;
        document.getElementById('tradeModalMaterialInfo').textContent = `${material.name} — Price: ${material.currentPrice} gold \u2022 Stock: ${material.availableStock}`;
        const qtyInput = document.getElementById('tradeQuantityInput');
        qtyInput.value = 1;
        qtyInput.min = 1;
        qtyInput.max = action === 'buy' ? material.availableStock : 1_000_000_000; // satış için mevcut envanter bilgisi yoksa sınırsız bırak
        qtyInput.oninput = updateTradeTotal;
        updateTradeTotal();
        document.getElementById('tradeModal').classList.remove('hidden');
    }

    function closeTradeModal() {
        document.getElementById('tradeModal').classList.add('hidden');
    }

    function updateTradeTotal() {
        const qty = parseInt(document.getElementById('tradeQuantityInput').value) || 0;
        const material = materials[tradeMaterialIndex] || { currentPrice: 0 };
        const total = qty * (material.currentPrice || 0);
        const text = tradeAction === 'sell' ? `Total revenue: ${total} gold` : `Total cost: ${total} gold`;
        document.getElementById('tradeTotalInfo').textContent = text;
    }

    async function confirmTrade() {
        const qtyRaw = document.getElementById('tradeQuantityInput').value;
        const quantity = parseInt(qtyRaw);
        if (!quantity || isNaN(quantity) || quantity <= 0) {
            showNotification('Enter a valid quantity.', 'error');
            return;
        }
        // Stok kontrolü (satın alma)
        if (tradeAction === 'buy') {
            const material = materials[tradeMaterialIndex];
            if (quantity > material.availableStock) {
                showAlert('The requested quantity exceeds available stock. Please enter a lower quantity.');
                return;
            }
            // Bakiye kontrolü (satın alma)
            const totalCost = quantity * (material.currentPrice || 0);
            if (typeof playerGold === 'number' && totalCost > playerGold) {
                showAlert('Insufficient gold balance. Please reduce the quantity or earn more gold.');
                return;
            }
        }
        await executeTrade(tradeAction, tradeMaterialIndex, quantity);
    }

    async function executeTrade(action, index, quantity) {
        try {
            const playerId = localStorage.getItem('id');
            if (!playerId) {
                showNotification('You must be logged in!', 'error');
                return;
            }

            const material = materials[index];
            const url = action === 'sell' ? `/api/Material/sell` : `/api/Material/buy`;
            const payload = { userId: playerId, materialId: material.id, quantity };

            const response = await api.post(url, payload, { headers: { 'Content-Type': 'application/json' } });

            if (response.status === 200) {
                const successMsg = action === 'sell'
                    ? `Successfully sold ${quantity} of ${material.name}!`
                    : `Successfully bought ${quantity} of ${material.name}!`;
                showNotification(successMsg, 'success');
                getProfileData();
                fetchMaterials();
                closeTradeModal();
            } else {
                showNotification('Action failed!', 'error');
            }
        } catch (error) {
            console.error('Trade error:', error);
            const msg = getFriendlyErrorMessage(error);
            showAlert(msg);
        }
    }

    function getFriendlyErrorMessage(error) {
        try {
            const data = error && error.response ? error.response.data : null;
            if (data) {
                if (typeof data === 'string') {
                    const lower = data.toLowerCase();
                    if (lower.includes('not enough gold') || lower.includes('insufficient') || lower.includes('yetersiz')) {
                        return 'Insufficient gold balance. Please reduce the quantity or earn more gold.';
                    }
                    if (lower.includes('out of stock') || lower.includes('stock') || lower.includes('available')) {
                        return 'The requested quantity is out of stock.';
                    }
                } else if (typeof data === 'object' && data.message) {
                    return String(data.message);
                }
            }
        } catch {}
        return 'The action could not be completed. Please try again.';
    }

    function showAlert(message) {
        const modal = document.getElementById('alertModal');
        const msg = document.getElementById('alertMessage');
        msg.textContent = message;
        modal.classList.remove('hidden');
    }

    function closeAlert() {
        document.getElementById('alertModal').classList.add('hidden');
    }

    function renderMaterials() {
        console.log("materyal cekiliyor");
        const tableBody = document.getElementById('materialTable');
        tableBody.innerHTML = '';
        materials.forEach((material, index) => {
            const change = material.priceChangePercentage;
            const changeClass = change > 0 ? 'price-up' : change < 0 ? 'price-down' : 'text-gray-400';
            const changeSymbol = change > 0 ? '↗️' : change < 0 ? '↘️' : '⏸️';
            const row = document.createElement('tr');
            row.className = 'border-b border-gray-600 hover:bg-white hover:bg-opacity-5 transition-colors';
            row.innerHTML = `
                <td class="py-4 px-6">
                    <div class="flex items-center space-x-3">
                        <span class="text-2xl">${getMaterialIcon(material.name)}</span>
                        <div>
                            <div class="font-semibold text-white">${material.name}</div>
                            <div class="text-sm text-gray-400">${material.description}</div>
                        </div>
                    </div>
                </td>
                <td class="py-4 px-6">
                    <span class="text-blue-300 font-semibold">${material.nationName}</span>
                </td>
                <td class="py-4 px-6">
                    <span class="text-xl font-bold text-yellow-400">${material.currentPrice}</span>
                    <span class="text-sm text-gray-400 ml-1">gold</span>
                </td>
                <td class="py-4 px-6">
                    <span class="${changeClass} font-bold">
                        ${changeSymbol} ${Math.abs(change).toFixed(1)}%
                    </span>
                </td>
                <td class="py-4 px-6">
                    <span class="text-gray-300">${material.availableStock} in stock</span>
                </td>
                <td class="py-4 px-6">
                    <div class="flex space-x-2">
                        <button onclick="buyMaterial(${index})"
                                class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
                            Buy
                        </button>
                        <button onclick="sellMaterial(${index})"
                                class="hidden bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
                            Sell
                        </button>
                    </div>
                </td>
            `;
            tableBody.appendChild(row);
        });
    }

    let events = [];
    const EVENT_MATERIAL_MAP = {
