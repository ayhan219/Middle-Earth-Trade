        "31524E47-CBD3-4D46-BE9C-163A847264D7": ["Silmaril", "Gümüş", "Nenya", "Dark Flame"],
        "1B452D9F-AFBA-4CCE-97E6-256C28565BB7": ["Silmaril", "Dokuz yüzük", "Tek yüzük"],
        "40DA64AE-4304-48E1-AFE0-29C603EA8319": ["Mithril Armor", "Narsil", "Glamdring", "Healing Orb"],
        "3CE7A51E-377B-4EFA-A407-350EDCC480DA": ["Lembas ekmeği", "Ent-Dalma", "Thor'un Haritası"],
        "E7AC0442-209E-4943-879A-AE98D65B4990": ["Silmaril", "Nenya"]
    };
                    async function fetchEvents() {
        try {
            const response = await api.get('/api/GameEvent');
            events = response.data;
            console.log("response",response.data)

            const now = new Date();

            if (Array.isArray(events) && events.length > 0) {
    
                const sortedEvents = events.sort((a, b) => new Date(a.startDate) - new Date(b.startDate));

                const pastEvents = sortedEvents.filter(e => new Date(e.startDate) <= now);

                    const currentEvent = sortedEvents.find(e => {
      const start = new Date(e.startDate);
      const end = new Date(e.endDate);
      return start <= now && now <= end;
    });

                const upcomingEvents = sortedEvents.filter(e => new Date(e.startDate) > now);
                const nextEvent = upcomingEvents.length > 0 ? upcomingEvents[0] : null;
                if (currentEvent) {
                    document.getElementById('eventTitle').textContent = currentEvent.name;
                    document.getElementById('eventDescription').textContent = currentEvent.description;
                } else {
                    document.getElementById('eventTitle').textContent = "No current event happening";
                    document.getElementById('eventDescription').textContent = "";
                }

                    const affectedMaterialsContainer = document.getElementById('affectedMaterialsContainer');

    if (nextEvent) {
        document.getElementById('eventTitle2').textContent = nextEvent.name;
        document.getElementById('eventDescription2').textContent = nextEvent.description;

        const key = String(nextEvent.id || '').toUpperCase();
        const materials = EVENT_MATERIAL_MAP[key] || [];

        affectedMaterialsContainer.innerHTML = materials.length > 0
            ? `<span class="text-blue-400">📊 Affected: ${materials.join(', ')}</span>`
            : `<span class="text-gray-400">📊 No affected materials found</span>`;

    } else {
        document.getElementById('eventTitle2').textContent = "No upcoming events found";
        document.getElementById('eventDescription2').textContent = "";
        affectedMaterialsContainer.innerHTML = "";
    }

            } else {
                document.getElementById('eventTitle').textContent = "No event data";
                document.getElementById('eventDescription').textContent = "";
                document.getElementById('eventTitle2').textContent = "";
                document.getElementById('eventDescription2').textContent = "";
            }
        } catch (error) {
            console.error("Could not fetch events:", error);
            showNotification("Could not fetch event data.", 'error');
        }
    }



    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.className = `fixed top-4 right-4 px-6 py-3 rounded-lg text-white font-semibold z-50 ${
            type === 'success' ? 'bg-green-600' : 'bg-red-600'
        }`;
        notification.textContent = message;
        document.body.appendChild(notification);
        setTimeout(() => {
            notification.remove();
        }, 3000);
    }

        function getProfileData() {
        try {
            const playerId = localStorage.getItem("id"); 
            console.log("Player ID:", playerId);
            if (!playerId) {
                console.warn("Player ID not found in localStorage.");
                showNotification("Player ID not found, please log in.", "error");
                return;
            }

            api.get(`/api/users/profile/${playerId}`)
                .then(response => {
                    const player = response.data;
                    console.log("Oyuncu verisi:", player);

                    if (player.gold !== undefined) {
                        playerGold = player.gold;
                        document.getElementById('playerGold').textContent = playerGold.toLocaleString();
                    }

                    if (player.portfolioValue !== undefined) {
                        document.getElementById('portfolioValue').textContent = player.portfolioValue.toLocaleString();
                    }

                    if (player.totalProfit !== undefined) {
                        document.getElementById('totalProfit').textContent =
                            (player.totalProfit >= 0 ? "+" : "") + player.totalProfit.toLocaleString();
                    }
                })
                .catch(error => {
                    console.error("Could not fetch player data:", error);
                    showNotification("Could not fetch player data.", "error");
                });
        } catch (err) {
            console.error("Error in getProfileData:", err);
            showNotification("An error occurred.", "error");
        }
    }


