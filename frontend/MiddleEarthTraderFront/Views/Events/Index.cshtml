@{
    ViewData["Title"] = "Events - Chronology of Middle Earth";
    Layout = "../Shared/_Layout.cshtml";
}

<style>
  /* Navbar'ı layout/site.css'ten alıyoruz; burada override yok */

  /* Kompakt görünüm: body.events-compact ile aktif olur */
  body.events-compact .header .title { font-size: 2.4rem; }
  body.events-compact .subtitle { font-size: 1rem; }
  body.events-compact .timeline-item { margin: 1.25rem 0; }
  body.events-compact .timeline-marker { width: 40px; height: 40px; font-size: 1.2rem; }
  body.events-compact .timeline-content { padding: 1rem; border-radius: 12px; }
  body.events-compact .event-year { font-size: 1rem; }
  body.events-compact .event-title { font-size: 1.15rem; }
  body.events-compact .event-description { font-size: 0.95rem; }
  body.events-compact .detail-title { font-size: 0.95rem; }
  body.events-compact .detail-item { font-size: 0.8rem; padding: 0.25rem 0.6rem; }
  body.events-compact .detail-section { margin-bottom: 0.75rem; }
  body.events-compact .age-divider { margin: 2.5rem 0; }
  body.events-compact .age-title { font-size: 1.6rem; padding: 0.7rem 1.4rem; }

  /* toolbar kullanılmıyor */
</style>
<script>
  // Body'e events-compact sınıfı zaten ekleniyor, arka planı etkinleştirir
  document.addEventListener('DOMContentLoaded', function(){
    document.body.classList.add('events-compact');
  });
</script>
<div style="margin-top:96px"></div>

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
<style>
  .current-badge{display:inline-block;margin-left:.5rem;padding:.2rem .5rem;border-radius:.4rem;background:#16a34a;color:#fff;font-weight:700;font-size:.8rem}
</style>

<div class="container">
    <div class="header">
        <h1 class="title">CHRONOLOGY OF MIDDLE EARTH</h1>
        <p class="subtitle">Historical Events Affecting the Material Exchange</p>
    </div>

    <div class="timeline">
        @await Html.PartialAsync("_TimelineContent")
    </div>
</div>

<script>
    function toggleDetails(element) {
        const details = element.querySelector('.event-details');
        const hint = element.querySelector('.expand-hint');
        document.querySelectorAll('.event-details.active').forEach(detail => {
            if (detail !== details) {
                detail.classList.remove('active');
                const h = detail.parentElement.querySelector('.expand-hint');
                if (h) h.style.display = 'block';
            }
        });
        if (details.classList.contains('active')) { details.classList.remove('active'); if (hint) hint.style.display = 'block'; }
        else { details.classList.add('active'); if (hint) hint.style.display = 'none'; }
    }
    document.addEventListener('DOMContentLoaded', function() {
        // Her zaman kompakt görünüm
        document.body.classList.add('events-compact');

        const timelineItems = document.querySelectorAll('.timeline-item');
        timelineItems.forEach((item, index) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(50px)';
            setTimeout(() => {
                item.style.transition = 'all 0.6s ease';
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });
</script>

<!-- Axios and api.js are loaded from _Layout -->
<script>
  // API'deki gerçek tarihleri ve aktif olayı timeline üzerinde işaretle
  async function annotateEventsFromApi(){
    try{
      const res = await api.get('/api/GameEvent');
      const events = Array.isArray(res.data) ? res.data : [];
      if(events.length === 0) return;
      const now = new Date();

      events.forEach(ev => {
        const title = (ev.name || '').trim();
        if(!title) return;
        const start = ev.startDate ? new Date(ev.startDate) : null;
        const end = ev.endDate ? new Date(ev.endDate) : null;
        const isCurrent = !!(start && end && start <= now && now <= end);
        const isPast = !!((end && end < now) || ev.alreadyHappened === true);

        // Başlık metni eşleşen kartı bul
        const allTitles = Array.from(document.querySelectorAll('.event-title'));
        const node = allTitles.find(n => n.textContent.trim().toLowerCase() === title.toLowerCase());
        if(!node) return;

        // Yıl alanını sadece süresi geçmiş olaylarda gerçek tarihle güncelle
        const yearNode = node.closest('.event-info').querySelector('.event-year');
        if (yearNode && start && isPast){
          const fmt = (d)=> d.toLocaleString('tr-TR', {year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit'});
          yearNode.textContent = end ? `${fmt(start)} — ${fmt(end)}` : fmt(start);
        }

        // Aktifse rozet ekle
        if (isCurrent){
          if (!node.querySelector('.current-badge')){
            const badge = document.createElement('span');
            badge.className = 'current-badge';
            badge.textContent = 'Happening Now';
            node.appendChild(badge);
          }
        }
      });
    }catch(e){ /* sessiz geç */ }
  }
  document.addEventListener('DOMContentLoaded', annotateEventsFromApi);
</script>


